<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OrbitalAuthority.Physics</RootNamespace>
    <AssemblyName>OrbitalAuthority.Physics</AssemblyName>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- ECS зависит только от Core -->
  <ItemGroup>
    <ProjectReference Include="..\OrbitalAuthority.Core\OrbitalAuthority.Core.csproj" />
    <ProjectReference Include="..\OrbitalAuthority.ECS\OrbitalAuthority.ECS.csproj" />
    <ProjectReference Include="..\OrbitalAuthority.Data\OrbitalAuthority.Data.csproj" />
  </ItemGroup>

</Project>